# URL publique du site (SEO, Open Graph, sitemap)
NUXT_PUBLIC_SITE_URL=

# Mesure d'audience (laisser vide pour désactiver)
NUXT_PUBLIC_ANALYTICS_ID=

# Emails transactionnels (formulaire de contact)
NUXT_MAIL_API_KEY=
NUXT_MAIL_FROM=
NUXT_CONTACT_RECIPIENT=

# Newsletter (Brevo, Mailchimp, Resend…)
NUXT_NEWSLETTER_API_KEY=
NUXT_NEWSLETTER_LIST_ID=

# WooCommerce headless (Réglages > Avancé > REST API dans l'admin WordPress)
# Connexion : installer le plugin « JWT Authentication for WP REST API » sur WordPress.
NUXT_WOO_BASE_URL=
NUXT_WOO_CONSUMER_KEY=
NUXT_WOO_CONSUMER_SECRET=

# Paiement par carte (Stripe — tableau de bord > Développeurs > Clés API)
# Sans ces clés, la page de commande s'affiche mais refuse d'encaisser.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET_KEY=
# Signature des webhooks (stripe listen, ou Développeurs > Webhooks)
# Sans elle, une commande payée puis abandonnée avant retour resterait en attente.
NUXT_STRIPE_WEBHOOK_SECRET=
